---
import PrintPage from "../../../../../components/print/PrintPage.astro";
import type { BloodOnTheClocktowerCustomScript } from "../../../../../generated/script-schema";
import {
  bytesToString,
  decompressFromBase64,
} from "../../../../../lib/compression";
import { MAX_AGE_SECONDS } from "../../../../../lib/constants";
import { createTranslator } from "../../../../../lib/i18n";

export const prerender = false;

const { b64 } = Astro.params;

if (!b64) {
  return Astro.rewrite("/404");
}

const bytes = await decompressFromBase64(b64, "deflate-raw", true);
const rawScript: BloodOnTheClocktowerCustomScript = JSON.parse(
  bytesToString(bytes),
);

const t = await createTranslator({ locale: Astro.currentLocale ?? "en" });

Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=${MAX_AGE_SECONDS}`,
);
---

<PrintPage t={t} rawScript={rawScript} />
