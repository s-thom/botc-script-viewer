---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import ScriptSidebarExtra from "../../../../components/display/ScriptSidebarExtra.astro";
import LocalisedMessage from "../../../../components/i18n/LocalisedMessage.astro";
import ScriptViewerLayout from "../../../../layouts/ScriptViewerLayout.astro";
import { BOTC_SCRIPTS_HOSTNAME } from "../../../../lib/constants";
import {
  createTranslator,
  ENABLED_LOCALES,
  type LocaleIds,
} from "../../../../lib/i18n";
import { getPathWithoutLocale } from "../../../../lib/url";
import { getLocalScriptCollections } from "../../../../scripts";

export function getStaticPaths() {
  const localScriptCollections = getLocalScriptCollections();

  return ENABLED_LOCALES.flatMap((locale) =>
    Object.entries(localScriptCollections).flatMap(
      ([collectionId, collection]) =>
        collection.scripts.map((script) => ({
          params: {
            collectionId: collectionId as keyof typeof localScriptCollections,
            scriptId: script.id,
            locale: locale.isDefault ? undefined : locale.astroId,
          },
        })),
    ),
  );
}

const { collectionId, scriptId } = Astro.params;

const localScriptCollections = getLocalScriptCollections();
if (!(collectionId in localScriptCollections)) {
  return Astro.rewrite("/404");
}

const collection = localScriptCollections[collectionId];

const scriptDefinition = collection.scripts.find(
  (script) => script.id === scriptId,
);
if (!scriptDefinition) {
  return Astro.rewrite("/404");
}

const locale = (Astro.currentLocale ?? "en") as LocaleIds;
const getScript =
  scriptDefinition.localeOverrides?.[locale] ?? scriptDefinition.getScript;
const rawScript = await getScript();

const t = await createTranslator({ locale });

let description: string | undefined;
if (collectionId === "base3") {
  description = t.string(`game.editions.${scriptId}.description`).value;
} else {
  const descriptionKey = `viewer.collection.${collectionId}.${scriptId}.description`;
  const resolved = t.resolve(descriptionKey);
  if (resolved.value) {
    description = t.string(descriptionKey).value;
  }
}
---

<ScriptViewerLayout
  t={t}
  rawScript={rawScript}
  basePath={getPathWithoutLocale(
    Astro.routePattern,
    Astro.currentLocale,
    Astro.url.pathname,
  )}
  canonicalRef={scriptDefinition.canonicalRef}
  overrideJsonPathSegment={`${scriptDefinition.id}.json`}
  color={scriptDefinition.color}
  fallbacks={{ description }}
>
  <ScriptSidebarExtra
    slot="sidebar-after-description"
    iconCharacterId={collectionId === "wc25" ? "djinn" : "steward"}
  >
    <LocalisedMessage
      t={t}
      key="viewer.collection.partOfCollection"
      params={{
        link: "..",
        linkKey: "back-to-collection",
        collection: t.string(`viewer.collection.${collectionId}.title`).value,
      }}
    />
  </ScriptSidebarExtra>
  {scriptDefinition.seeAlsoRefs && (
    <ScriptSidebarExtra
      slot="sidebar-after-description"
      iconCharacterId="fortuneteller"
    >
      <LocalisedMessage t={t} key="viewer.script.seeAlso" />{" "}
      {scriptDefinition.seeAlsoRefs.map((otherRef) => (
        <a
          class="version-link"
          href={getAbsoluteLocaleUrl(
            locale,
            `${otherRef.collectionId}/${otherRef.scriptId}`,
          )}
          data-umami-event="sidebar-see-also"
          data-umami-event-collection-id={otherRef.collectionId}
          data-umami-event-script-id={otherRef.scriptId}
        >
          {localScriptCollections[
            otherRef.collectionId as keyof typeof localScriptCollections
          ].scripts.find((script) => script.id === otherRef.scriptId)?.title ??
            ""}
        </a>
      ))}
    </ScriptSidebarExtra>
  )}
  {scriptDefinition.botcScripts && (
    <ScriptSidebarExtra
      slot="sidebar-after-description"
      iconCharacterId="grandmother"
    >
      <LocalisedMessage
        t={t}
        key="viewer.script.viewOnBotcScripts"
        params={{
          externalLink: `https://${BOTC_SCRIPTS_HOSTNAME}/script/${scriptDefinition.botcScripts.scriptId}/${scriptDefinition.botcScripts.versionId}`,
          externalLinkKey: "botc-scripts",
        }}
      />
    </ScriptSidebarExtra>
  )}
</ScriptViewerLayout>

<style>
  @media screen {
    .before-script {
      margin: 2rem 1rem;

      @media (min-width: 900px) {
        margin: 2rem;
      }
    }
  }
</style>
