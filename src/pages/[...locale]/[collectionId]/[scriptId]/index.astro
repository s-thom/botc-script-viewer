---
import ScriptSidebarExtra from "../../../../components/display/ScriptSidebarExtra.astro";
import LocalisedMessage from "../../../../components/i18n/LocalisedMessage.astro";
import ScriptViewerLayout from "../../../../layouts/ScriptViewerLayout.astro";
import { BOTC_SCRIPTS_HOSTNAME } from "../../../../lib/constants";
import {
  createTranslator,
  ENABLED_LOCALES,
  type LocaleIds,
} from "../../../../lib/i18n";
import { getPathWithoutLocale } from "../../../../lib/url";
import { LOCAL_SCRIPT_COLLECTIONS } from "../../../../scripts";

export function getStaticPaths() {
  return ENABLED_LOCALES.flatMap((locale) =>
    Object.entries(LOCAL_SCRIPT_COLLECTIONS).flatMap(
      ([collectionId, collection]) =>
        collection.scripts.map((script) => ({
          params: {
            collectionId: collectionId as keyof typeof LOCAL_SCRIPT_COLLECTIONS,
            scriptId: script.id,
            locale: locale.isDefault ? undefined : locale.astroId,
          },
        })),
    ),
  );
}

const { collectionId, scriptId } = Astro.params;

if (!(collectionId in LOCAL_SCRIPT_COLLECTIONS)) {
  return Astro.rewrite("/404");
}

const collection = LOCAL_SCRIPT_COLLECTIONS[collectionId];

const scriptDefinition = collection.scripts.find(
  (script) => script.id === scriptId,
);
if (!scriptDefinition) {
  return Astro.rewrite("/404");
}

const locale = (Astro.currentLocale ?? "en") as LocaleIds;
const getScript =
  scriptDefinition.localeOverrides?.[locale] ?? scriptDefinition.getScript;
const rawScript = await getScript();

const t = await createTranslator({ locale });

const description =
  collectionId === "base3"
    ? t.string(`game.editions.${scriptId}.description`).value
    : undefined;
---

<ScriptViewerLayout
  t={t}
  rawScript={rawScript}
  basePath={getPathWithoutLocale(
    Astro.routePattern,
    Astro.currentLocale,
    Astro.url.pathname,
  )}
  canonicalRef={scriptDefinition.canonicalRef}
  overrideJsonPathSegment={`${scriptDefinition.id}.json`}
  color={scriptDefinition.color}
  fallbacks={{ description }}
>
  <ScriptSidebarExtra
    slot="sidebar-after-description"
    iconCharacterId={collectionId === "wc25" ? "djinn" : "steward"}
  >
    <LocalisedMessage
      t={t}
      key="viewer.collection.partOfCollection"
      params={{
        link: "..",
        collection: t.string(`viewer.collection.${collectionId}.title`).value,
      }}
    />
  </ScriptSidebarExtra>
  {
    scriptDefinition.botcScripts && (
      <ScriptSidebarExtra
        slot="sidebar-after-description"
        iconCharacterId="grandmother"
      >
        <LocalisedMessage
          t={t}
          key="viewer.script.viewOnBotcScripts"
          params={{
            externalLink: `https://${BOTC_SCRIPTS_HOSTNAME}/script/${scriptDefinition.botcScripts.scriptId}/${scriptDefinition.botcScripts.versionId}`,
          }}
        />
      </ScriptSidebarExtra>
    )
  }
</ScriptViewerLayout>

<style>
  @media screen {
    .before-script {
      margin: 2rem 1rem;

      @media (min-width: 900px) {
        margin: 2rem;
      }
    }
  }
</style>
