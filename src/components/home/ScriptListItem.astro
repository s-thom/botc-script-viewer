---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { ScriptMetadata } from "../../generated/script-schema";
import { CHARACTERS_BY_ID } from "../../lib/characters";
import { getHeaderColor } from "../../lib/color";
import { type LocaleIds, type Translator } from "../../lib/i18n";
import type { LocalScriptDefinition } from "../../types/site";
import CharacterIcon from "../display/CharacterIcon.astro";

export interface Props {
  t: Translator;
  collectionId: string;
  script: LocalScriptDefinition;
  loading?: "eager" | "lazy";
  page?: string;
}

const { t, collectionId, script, loading, page } = Astro.props;

const getScript =
  script.localeOverrides?.[t.locale as LocaleIds] ?? script.getScript;
const rawScript = await getScript();
const meta = rawScript.find(
  (item): item is ScriptMetadata =>
    typeof item === "object" && item.id === "_meta",
);
let title = meta?.name || script.title;

const tiltHash = [...script.id].reduce(
  (hash, char) => (hash * 31 + char.charCodeAt(0)) | 0,
  0,
);
const tilt = (tiltHash & 1 ? 1 : -1) * (0.7 + ((tiltHash >>> 1) % 3) * 0.25);

if (
  collectionId === "month" &&
  "date" in script &&
  script.date instanceof Date
) {
  title = t
    .DateTimeFormat({
      month: "long",
      year: "numeric",
    })
    .format(script.date);
}
---

<a
  href={getRelativeLocaleUrl(
    Astro.currentLocale ?? "en",
    `/${collectionId}/${script.id}`,
  )}
  class:list={["handbill"]}
  style={{
    "--handbill-color": getHeaderColor(script.color),
    "--handbill-tilt": `${tilt}deg`,
  }}
  data-umami-event="script-list-item"
  data-umami-event-collection-id={collectionId}
  data-umami-event-script-id={script.id}
  data-umami-event-page={page}
>
  {<span class="handbill-band" />}
  <CharacterIcon
    class="script-icon"
    size={64}
    character={CHARACTERS_BY_ID.get(script.character)!}
    loading={loading}
  />
  <span class="script-title">{title}</span>
</a>

<style>
  .handbill {
    --band-height: 1.125rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    height: 100%;
    padding: 0 0.75rem 0.625rem;
    background-color: var(--color-paper);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
    text-decoration: none;
    rotate: var(--handbill-tilt);
    transform-origin: 50% calc(var(--band-height) / 2);

    @media (prefers-reduced-motion: no-preference) {
      transition:
        rotate 0.2s ease-out,
        box-shadow 0.2s ease-out;
    }

    &:hover,
    &:focus-visible {
      rotate: 0deg;
      box-shadow: 0 6px 14px rgb(0 0 0 / 0.3);
    }

    .script-title {
      font-family: var(--font-title);
      font-size: 1.4rem;
      line-height: 1.1;
      text-align: center;
      text-wrap: balance;
    }
  }

  .handbill-band {
    align-self: stretch;
    height: var(--band-height);
    margin-inline: -0.75rem;
    margin-block-end: 0.375rem;
    background: url("../../assets/header-ferns.webp")
      var(--handbill-color, #20562d);
    background-blend-mode: multiply;
    clip-path: polygon(
      0 0,
      0 100%,
      20% calc(100% - 4px),
      45% calc(100% - 1px),
      70% calc(100% - 5px),
      100% calc(100% - 2px),
      100% 0
    );
  }
</style>
