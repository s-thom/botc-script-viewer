---
import type { Translator } from "../../lib/i18n";
import LocalisedMessage from "../i18n/LocalisedMessage.astro";

interface Props {
  t: Translator;
}

const { t } = Astro.props;
---

<form
  id="script-form"
  method="POST"
  action="/go"
  enctype="multipart/form-data"
  class="form"
>
  <h2>
    <label for="script">
      <LocalisedMessage t={t} key="viewer.home.pasteJsonOrUrl" />
    </label>
  </h2>

  <input type="hidden" name="locale" value={t.locale} />

  <textarea class="inset-field text-input" name="script" id="script"></textarea>

  <button type="submit" class="button" data-umami-event="script-submit">
    <LocalisedMessage t={t} key="viewer.home.viewScript" />
  </button>
</form>

<style>
  .form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }
</style>
