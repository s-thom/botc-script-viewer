---
import type { BloodOnTheClocktowerCustomScript } from "../generated/script-schema";
import TopBarLayout from "../layouts/TopBarLayout.astro";
import { getHeaderColor } from "../lib/color";
import { compressToBase64, stringToBytes } from "../lib/compression";
import type { LocaleIds } from "../lib/i18n";
import type { Translator } from "../lib/i18n/types";
import {
  applyNormalisedScriptFallbacks,
  normaliseScript,
} from "../lib/normalise";
import { buildPrintData } from "../lib/print/build-data";
import type { NormalisedScriptFallbacks } from "../types/botc";
import LocalisedMessage from "../components/i18n/LocalisedMessage.astro";
import PrintApp from "../components/print/PrintApp.svelte";
import Footer from "../components/misc/Footer.astro";

interface Props {
  t: Translator;
  rawScript: BloodOnTheClocktowerCustomScript;
  basePath: string;
  fallbacks?: NormalisedScriptFallbacks;
  color?: string;
}

const { t, rawScript, basePath, fallbacks, color: overrideColor } = Astro.props;

const script = normaliseScript(rawScript, t);
if (fallbacks) {
  applyNormalisedScriptFallbacks(script, fallbacks);
}

const color = getHeaderColor(overrideColor ?? script.color);

// The print page lives directly beneath the script's own page.
const scriptPath = Astro.url.pathname.replace(/\/print\/?$/, "") || "/";
const data = await buildPrintData(t, script, {
  src: `${scriptPath.replace(/\/$/, "")}/qr.svg`,
  url: new URL(scriptPath, Astro.url).toString(),
});

const rawScriptString = JSON.stringify(rawScript);
const rawScriptBytes = stringToBytes(rawScriptString);
const rawScriptB64 = await compressToBase64(rawScriptBytes, "gzip", false);
const scriptBuilderUrl = `https://script.bloodontheclocktower.com/?script=${encodeURIComponent(rawScriptB64)}`;

const title = t.string("viewer.print.pageTitle", { title: data.title }).value;
---

<TopBarLayout
  t={t}
  meta={{
    title: t.string("viewer.head.title", {
      title,
      nameShort: t.string("viewer.common.nameShort").value,
    }).value,
    translate: {
      basePath,
      locales: "all",
    },
    lang: t.locale as LocaleIds,
    noIndex: true,
    color,
  }}
>
  <ul class="nav-links" slot="items-start">
    <li>
      <a href={scriptPath} data-umami-event="print-back-to-script">
        {t.string("viewer.print.backToScript").value}
      </a>
    </li>
    <li>
      <a
        href={scriptBuilderUrl}
        rel="external noreferrer"
        target="_blank"
        data-umami-event="script-open-official-builder"
      >
        <LocalisedMessage t={t} key="viewer.navigation.edit" />
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
          class="inline-icon"
        >
          <path d="M15 9.5v3a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5v-9A2.5 2.5 0 0 1 3.5 1h3a.5.5 0 0 1 0 1h-3C2.67 2 2 2.67 2 3.5v9c0 .83.67 1.5 1.5 1.5h9c.83 0 1.5-.67 1.5-1.5v-3a.5.5 0 0 1 1 0M14.5 1h-5a.5.5 0 0 0 0 1h3.8L9.14 6.15a.5.5 0 0 0 .7.7L14 2.71V6.5a.5.5 0 0 0 1 0v-5a.5.5 0 0 0-.5-.5"></path>
        </svg>
      </a>
    </li>
  </ul>

  <main class="print-page">
    <PrintApp client:only="svelte" data={data}>
      <p slot="fallback" class="screen-only">
        {t.string("viewer.print.loading").value}
      </p>
      <Footer slot="footer" t={t} isScreenOnly />
    </PrintApp>

    <noscript>
      <p class="screen-only">{t.string("viewer.print.noscript").value}</p>
    </noscript>
  </main>
</TopBarLayout>

<style>
  .nav-links {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding-inline-start: 0;
    gap: 0.5rem;
    list-style: none;
  }

  .print-page {
    padding: 1rem;

    @media print {
      padding: 0;
    }
  }
</style>
