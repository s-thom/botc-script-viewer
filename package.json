{
  "name": "botc-script-viewer",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup": "wrangler types && node setup/index.ts",
    "validate": "node setup/ensure-characters-in-number-store.ts",
    "dev": "astro dev",
    "build": "astro build",
    "full-build": "npm run setup && npm run build",
    "preview": "astro preview",
    "lint": "eslint .",
    "astro": "astro",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:all": "node --test && playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.0",
    "astro": "^7.4.0",
    "culori": "^4.0.2",
    "idb": "^8.0.4",
    "language-icons": "^0.3.0",
    "qrcode-svg": "^1.1.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/compat": "^2.1.1",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.62.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/qrcode-svg": "^1.1.5",
    "@types/umami": "^2.10.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-prettier": "^5.5.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "p-queue": "^10.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "public-google-sheets-parser": "^1.5.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": "$eslint-plugin-jsx-a11y-x"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
